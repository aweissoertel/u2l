{
  "name": "u2l",
  "version": "0.1.0",
  "description": "Ultimate Guitar → LaTeX (songs-Paket) für unser Liederbuch",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "2.1.9",
    "entities": "9.0.0",
    "hono": "4.13.19"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
